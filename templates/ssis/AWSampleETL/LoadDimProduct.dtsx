                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">ISNULL(#{Package\Load stg_Product\Source - Product.Outputs[OLE DB Source Output].Columns[ProductLine]}) ? "N/A" : TRIM(#{Package\Load stg_Product\Source - Product.Outputs[OLE DB Source Output].Columns[ProductLine]}) == "R" ? "Road" : TRIM(#{Package\Load stg_Product\Source - Product.Outputs[OLE DB Source Output].Columns[ProductLine]}) == "M" ? "Mountain" : TRIM(#{Package\Load stg_Product\Source - Product.Outputs[OLE DB Source Output].Columns[ProductLine]}) == "T" ? "Touring" : TRIM(#{Package\Load stg_Product\Source - Product.Outputs[OLE DB Source Output].Columns[ProductLine]}) == "S" ? "Standard" : "Other"</property>
