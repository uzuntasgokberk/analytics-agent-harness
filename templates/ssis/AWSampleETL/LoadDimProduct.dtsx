                          expressionType="Notify"
                          name="FriendlyExpression">ISNULL(ProductLine) ? "N/A" : TRIM(ProductLine) == "R" ? "Road" : TRIM(ProductLine) == "M" ? "Mountain" : TRIM(ProductLine) == "T" ? "Touring" : TRIM(ProductLine) == "S" ? "Standard" : "Other"</property>
